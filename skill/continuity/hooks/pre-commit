#!/usr/bin/env bash
# cross-agent-dev:state-check
# 提交前检查：连续多次提交都改了代码却没更新 STATE.md 时，拦下提交。
# 对所有 Coding Agent 都生效（它是 git 自己的检查，不依赖某个 Agent）。
#
# 跳过一次：  SKIP_STATE_CHECK=1 git commit ...
# 调整阈值：  git config continuity.maxCommitsWithoutState 5   （默认 3）
set -u

[[ "${SKIP_STATE_CHECK:-}" == 1 ]] && exit 0

root="$(git rev-parse --show-toplevel 2>/dev/null)" || exit 0
state="STATE.md"

# 项目没用 STATE.md（或还没提交过）就不管。
git -C "$root" ls-files --error-unmatch "$state" >/dev/null 2>&1 || exit 0

staged="$(git diff --cached --name-only)"
[[ -z "$staged" ]] && exit 0
# 这次提交更新了 STATE.md：通过。
grep -qxF "$state" <<< "$staged" && exit 0

max="$(git config --get continuity.maxCommitsWithoutState 2>/dev/null || echo 3)"
[[ "$max" =~ ^[0-9]+$ ]] || max=3
(( max <= 0 )) && exit 0

last="$(git log -1 --format=%H -- "$state")"
since="$(git rev-list --count "${last}..HEAD" 2>/dev/null || echo 0)"

# 加上这一次，没更新 STATE 的提交数达到阈值就拦。
if (( since + 1 >= max )); then
  cat >&2 <<MSG
✗ 提交被拦下：已经连续 $((since + 1)) 次提交代码，但 STATE.md 一直没更新。

  请先更新 STATE.md：勾掉已验证完成的项、写清做到一半的项差什么、补上新的决定，
  然后 git add STATE.md 再提交（可以和这次代码一起提交）。

  确实不需要更新时：SKIP_STATE_CHECK=1 git commit ...
  （Agent：跳过前先征得用户同意。）
MSG
  exit 1
fi
exit 0
